# Backend configuration CONTRACT — every env var the server reads.
#
# Local dev: `just setup` copies this to `backend/.env` and fills the crypto
# secrets for you. `.env` is gitignored; never commit one.
# Deployed: deliver these as real secrets (SOPS → your platform's secret store,
# or SOPS → SealedSecret on Kubernetes). See ../README.md.
# Settings::from_env reports EVERY missing/malformed var at once on startup.

# Server
# DEV_MODE=true enables verbose errors, the Swagger UI, console-email/no-op
# adapter fallbacks, and the OAuth test bypass. NEVER set it true in production.
# Defaults to false here so copying this template can't silently run a
# prod-ish deploy in dev mode; set DEV_MODE=true in your local .env for
# development.
DEV_MODE=false
SERVER_HOST=0.0.0.0
SERVER_PORT=4322
APP_NAME=App
FRONTEND_BASE_URL=http://localhost:4321

# Database
DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_MAX_CONNECTIONS=5

# JWT — RSA keys (generate with the commands below)
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
#   Then paste the PEM contents (including header/footer lines) as single-line values
#   with literal \n between lines, or use multiline values in a .env file.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=30

# CSRF secret — base64-encoded 32 random bytes. Both url-safe and standard
# base64 are accepted, so either command works:
#   openssl rand -base64 32          # standard alphabet (+/ with = padding)
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='   # url-safe (matches README)
CSRF_SECRET=

# Secrets-at-rest key — base64-encoded 32 random bytes (AES-256-GCM).
# Encrypts any third-party secret the app must store in Postgres (prefer not
# storing them at all; see the notes vault). Rotating this key makes existing ciphertext
# undecryptable, so treat it like JWT_PRIVATE_KEY.
#   openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Argon2id password hashing
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Google OAuth (set GOOGLE_OAUTH_ENABLED=true to require the three vars below)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4321/api/v1/auth/oauth/google/callback

# SMTP email — all four required to enable; falls back to console logging if absent
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=App

# Bot protection — optional, startup warning if absent
# Cloudflare Turnstile secret key (from dash.cloudflare.com → Turnstile)
TURNSTILE_SECRET_KEY=
# Enable DNS MX record validation on registration (true/false)
MX_VALIDATION_ENABLED=false


# Admin panel: the first admin is created with `just grant-admin <email>`.

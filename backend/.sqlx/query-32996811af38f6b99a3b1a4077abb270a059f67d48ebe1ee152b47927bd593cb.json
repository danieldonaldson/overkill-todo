{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT l.id, l.user_id, l.name, l.version, l.created_at,\n                   COUNT(t.id) FILTER (WHERE t.completed_at IS NULL) AS \"open_count!\",\n                   COUNT(t.id) AS \"todo_count!\"\n            FROM lists l\n            LEFT JOIN todos t ON t.list_id = l.id\n            WHERE l.user_id = $1\n            GROUP BY l.id\n            ORDER BY l.created_at, l.id\n            ",

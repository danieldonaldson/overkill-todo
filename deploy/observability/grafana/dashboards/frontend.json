    {
      "id": 12,
      "type": "timeseries",
      "title": "p75 CLS by page and device class",
      "description": "Cumulative Layout Shift per page visit (largest session window), 75th percentile over the last hour at each point. Good up to 0.1, poor over 0.25.",
      "gridPos": {

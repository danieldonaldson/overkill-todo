    {
      "id": 14,
      "type": "table",
      "title": "Release $release: p75 Web Vitals, 24 h before and after",
      "description": "75th percentile of each Web Vital over the 24 hours before the selected release's first page load and the 24 hours after it (the purple release annotations mark those times). The comparison is by time: right after a deploy, tabs still open on the previous release are mixed in for a while. LCP, FCP, TTFB and INP are in ms; CLS is a score. An empty After column means 24 hours haven't passed yet, or nothing was measured.",
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 70
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "Before",
          "expr": "histogram_quantile(0.75, sum by (name, le) (increase(browser_web_vital_milliseconds_bucket[24h] @ ${release_start})))\nor\nlabel_replace(histogram_quantile(0.75, sum by (le) (increase(browser_web_vital_cls_bucket[24h] @ ${release_start}))), \"name\", \"CLS\", \"\", \"\")",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "After",
          "expr": "histogram_quantile(0.75, sum by (name, le) (increase(browser_web_vital_milliseconds_bucket[24h] @ ${release_start} offset -24h)))\nor\nlabel_replace(histogram_quantile(0.75, sum by (le) (increase(browser_web_vital_cls_bucket[24h] @ ${release_start} offset -24h))), \"name\", \"CLS\", \"\", \"\")",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "name": "Vital",
              "Value #Before": "Before",
              "Value #After": "After"
            },
            "indexByName": {
              "name": 0,
              "Value #Before": 1,
              "Value #After": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 15,
      "type": "bargauge",
      "title": "Browser error rate by release (selected range)",
      "description": "Errors from the site's own scripts per page load of each release, over the selected range. Exact per release: both counts carry the release (page loads through browser.release_seen). Releases beyond the 5 a replica labels are grouped as other.",
      "gridPos": {

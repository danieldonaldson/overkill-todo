    {
      "id": 11,
      "type": "timeseries",
      "title": "p75 LCP by page and device class",
      "description": "Largest Contentful Paint per full page load, 75th percentile over the last hour at each point. Good up to 2.5 s, poor over 4 s.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,

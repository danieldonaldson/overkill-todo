    {
      "id": 10,
      "type": "timeseries",
      "title": "p75 INP by page and device class",
      "description": "Interaction to Next Paint per page visit, 75th percentile over the last hour at each point (the BrowserVitalPoor window). Good up to 200 ms, poor over 500 ms.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 52
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (page, device_class, le) (increase(browser_web_vital_milliseconds_bucket{name=\"INP\"}[1h])))",

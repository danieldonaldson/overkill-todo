    {
      "id": 13,
      "type": "bargauge",
      "title": "Rating shares by vital (selected range)",
      "description": "Share of measurements rated good, needs improvement and poor, per Web Vital, over the selected range.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 61
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "sum by (name, rating) (increase(browser_web_vital_milliseconds_count[$__range]))\n  / ignoring (rating) group_left\nsum by (name) (increase(browser_web_vital_milliseconds_count[$__range]))\nor\nlabel_replace(\n  sum by (rating) (increase(browser_web_vital_cls_count[$__range]))\n    / ignoring (rating) group_left\n  sum (increase(browser_web_vital_cls_count[$__range])),\n  \"name\", \"CLS\", \"\", \"\"\n)",
          "instant": true,
          "range": false,
          "legendFormat": "{{name}} {{rating}}"
        }
      ],
      "fieldConfig": {
        "defaults": {

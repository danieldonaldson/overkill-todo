{
  "uid": "frontend",
  "title": "Frontend",
  "tags": [
    "overkill-todo",
    "OT-006"
  ],
  "description": "Browser errors and page loads reported by the site (OT-006). Reports are scrubbed in the browser and again on the server: pages are templates, never addresses; no query strings, fragments, emails or tokens. Members are named by user ID only, taken from the session. Page loads are the error rate's denominator, not traffic analytics (that is OT-005). Errors from other origins (extensions, third-party scripts) are logged but not counted in the error rate. Web Vitals are measured on the sampled share of page loads (PUBLIC_RUM_SAMPLE_RATE); LCP, FCP and TTFB per full load, INP and CLS per page visit. Navigation and panel timings come in a later slice.",
  "editable": false,
  "schemaVersion": 41,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "release",
        "label": "Release",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "description": "The release the before-and-after comparison is about.",
        "query": {
          "query": "label_values(browser_release_seen_total{release!=\"other\"}, release)",
          "refId": "release"
        },
        "definition": "label_values(browser_release_seen_total{release!=\"other\"}, release)",
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 0
      },
      {
        "name": "release_start",
        "label": "Release first seen",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "hide": 2,
        "description": "Unix time of the selected release's first page load, within the 30 days metrics are kept (MetricsQL tfirst_over_time).",
        "query": {
          "query": "query_result(min(tfirst_over_time(browser_release_seen_total{release=\"$release\"}[30d])))",
          "refId": "release_start"
        },
        "definition": "query_result(min(tfirst_over_time(browser_release_seen_total{release=\"$release\"}[30d])))",
        "regex": "/(\\d{9,})/",
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Browser errors",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Browser error rate by page and release",
      "description": "Errors from the site's own scripts per page load, per page template and release (the BrowserErrorRateHigh alert's measure; it fires above 2% for 10 minutes with at least 1 page load a minute). Page loads carry no release, so right after a deploy each release's rate is measured against all of that page's loads.",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "range": true,
          "expr": "sum by (page, release) (increase(browser_error_total[$__rate_interval]))\n  / on (page) group_left\nsum by (page) (increase(browser_page_load_total[$__rate_interval]))",
          "legendFormat": "{{page}} {{release}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Dropped browser reports",
      "description": "Report events over the backend's recording budget (CLIENT_TELEMETRY_MAX_EVENTS_PER_SEC), counted but not recorded. Anything here means the errors above are undercounted.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(increase(browser_report_dropped_total[$__interval])) or vector(0)",
          "legendFormat": "dropped",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Browser error reports by page and release (logs)",
      "description": "Occurrences of browser errors (each report's count), per page template and release. From the client_error log events.",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "event:=\"client_error\" | stats by (page, release) sum(count) as errors",
          "queryType": "statsRange",
          "legendFormat": "{{page}} {{release}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Page loads by page",
      "description": "Finished page loads and in-site navigations per page template: the error rate's denominator, not traffic analytics. Never sampled.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "range": true,
          "expr": "sum by (page) (increase(browser_page_load_total[$__interval]))",
          "legendFormat": "{{page}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top errors (by fingerprint)",
      "description": "The most frequent browser errors in the time range, grouped by fingerprint, with when each was first and last seen. Decode a stack from the example reports below with `just decode-stack <release>`.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "_time:$__range event:=\"client_error\" | stats by (error_fingerprint, kind) sum(count) as occurrences, count_uniq(page_load_id) as page_loads, min(_time) as first_seen, max(_time) as last_seen, uniq_values(page) as pages, uniq_values(release) as releases, uniq_values(error_message) limit 1 as message | sort by (occurrences desc) | limit 50",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "occurrences",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Example reports",
      "description": "Recent browser errors, newest first. client_trace_id (failed API calls only) opens the backend trace. user_id is present only for a signed-in Member, from the session.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "event:=\"client_error\" | sort by (_time desc) | limit 100 | fields _time, page, release, kind, error_message, count, error_fingerprint, client_trace_id, api_route, status, user_id, page_load_id, browser_family, device_class, source, stack",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "client_trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View trace",
                    "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22${__value.raw}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "stack"
            },
            "properties": [
              {
                "id": "custom.inspect",
                "value": true
              },
              {
                "id": "custom.width",
                "value": 400
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": []
    },
    {
      "id": 8,
      "type": "row",
      "title": "Web Vitals",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "table",
      "title": "p75 Web Vitals by page, device class and sign-in (selected range)",
      "description": "75th percentile of each Web Vital over the selected time range (up to the 30 days metrics are kept). LCP, FCP and TTFB are per full page load; INP and CLS per page visit, including visits reached by in-site navigation. Green is good, orange needs improvement, red is poor (standard thresholds). Measured on the sampled share of page loads (PUBLIC_RUM_SAMPLE_RATE). The BrowserVitalPoor alert fires on a page whose p75 INP stays over 500 ms or LCP over 4 s for an hour, with at least 50 measurements an hour.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "LCP",
          "expr": "histogram_quantile(0.75, sum by (page, device_class, authenticated, le) (increase(browser_web_vital_milliseconds_bucket{name=\"LCP\"}[$__range])))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "FCP",
          "expr": "histogram_quantile(0.75, sum by (page, device_class, authenticated, le) (increase(browser_web_vital_milliseconds_bucket{name=\"FCP\"}[$__range])))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "TTFB",
          "expr": "histogram_quantile(0.75, sum by (page, device_class, authenticated, le) (increase(browser_web_vital_milliseconds_bucket{name=\"TTFB\"}[$__range])))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "INP",
          "expr": "histogram_quantile(0.75, sum by (page, device_class, authenticated, le) (increase(browser_web_vital_milliseconds_bucket{name=\"INP\"}[$__range])))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "CLS",
          "expr": "histogram_quantile(0.75, sum by (page, device_class, authenticated, le) (increase(browser_web_vital_cls_bucket[$__range])))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "page": "Page",
              "device_class": "Device",
              "authenticated": "Signed in"
            },
            "indexByName": {
              "page": 0,
              "device_class": 1,
              "authenticated": 2,
              "Value #LCP": 3,
              "Value #FCP": 4,
              "Value #TTFB": 5,
              "Value #INP": 6,
              "Value #CLS": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #LCP"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p75 LCP"
              },
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 2500
                    },
                    {
                      "color": "red",
                      "value": 4000
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #FCP"
            },
            "properties": [
              {
                "id": "displayName",

# Production edge for the single-host deployment. Caddy gets and renews the TLS
# certificate for $DOMAIN on its own; ports 80 and 443 must reach this host.
{
	# Client address (OT-005 D4): forwarded headers are believed only from
	# Cloudflare, walking X-Forwarded-For right to left. Anyone else gets the
	# connection's address.
	servers {
		# Cloudflare's published ranges, from https://www.cloudflare.com/ips-v4
		# and https://www.cloudflare.com/ips-v6, checked 2026-11-13. They
		# change rarely; re-check when touching this file.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$DOMAIN} {
	encode zstd gzip

	# `route` keeps this order. Caddy's default order runs `tracing` before
	# `request_header`, which would adopt a client's trace context before it is
	# stripped. The edge starts every trace (design Decision 3); the backend
	# trusts the `traceparent` the edge sets because only the edge reaches it.
	route {
		request_header -traceparent
		request_header -tracestate
		# Only the edge may say who the client is (OT-005 D4).
		request_header -X-Analytics-Client-IP
		# Exports to the collector over OTLP/gRPC (OTEL_* env in compose.yaml)
		# and puts `traceID`/`spanID` on the access log line.
		tracing {
			span "{http.request.method} edge"
		}

		handle /api/* {
			reverse_proxy backend:4322
		}
		# Web analytics (OT-005 D3): only the tracker and the collect endpoint
		# are public; Umami's login and reports answer 404.
		handle_path /stats/* {
			@collect path /script.js /api/send
			handle @collect {
				reverse_proxy umami:3000 {
					header_up X-Analytics-Client-IP {client_ip}
					# The script load is a same-origin request, so the browser
					# attaches the session cookie. Umami needs none of it.
					header_up -Cookie
					header_up -Authorization
				}
			}
			handle {
				respond 404
			}
		}
		handle {
			reverse_proxy web:8080
		}
	}

	log {
		output stdout
		format json
	}
}

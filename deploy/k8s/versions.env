# Versions of what runs in the local cluster (OT-014 D14). CLIs are pinned in
# .mise.toml. Kubernetes stays at the newest minor that Talos, Cilium,
# cert-manager, CNPG and ArgoCD all list as tested (checked 2026-11-25:
# cert-manager 1.21, CNPG 1.30 and Cilium 1.20 stop at 1.36).
TALOS_VERSION=v1.14.7
KUBERNETES_VERSION=1.36.6
CILIUM_VERSION=1.20.5
ARGOCD_VERSION=v3.6.3
ARGOCD_CHART_VERSION=10.20.0
SOPS_OPERATOR_CHART_VERSION=0.30.2
SOPS_OPERATOR_VERSION=0.22.5
RELOADER_CHART_VERSION=2.2.21
LOCAL_PATH_VERSION=v0.0.37

---
import AuthLayout from '../layouts/AuthLayout.astro'
import SetPasswordForm from '../components/auth/SetPasswordForm.svelte'

const token = Astro.url.searchParams.get('token') ?? ''
const email = Astro.url.searchParams.get('email') ?? ''
---

<AuthLayout title="Set password | app" heading="Set your password">
  <SetPasswordForm client:load {token} {email} />
</AuthLayout>

    "astro": "7.4.7",
    "bits-ui": "^2.20.6",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.57.3",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.0",

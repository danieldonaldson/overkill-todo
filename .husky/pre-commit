if git diff --cached --name-only | grep -Eq '^(\.husky/pre-commit|justfile|backend/(Cargo\.(toml|lock)|build\.rs|rust-toolchain.*|\.cargo/|\.sqlx/|migrations/|src/|tests/))'; then
    echo "Running backend fmt check..."
    just fmt-check || { echo "  rustfmt failed. Run: just fmt"; exit 1; }

    echo "Running backend clippy..."
    just lint || { echo "  clippy failed. Run: just lint"; exit 1; }
else
    echo "Skipping backend checks; no relevant staged backend files changed."
fi

if git diff --cached --name-only | grep -Eq '^(\.husky/pre-commit|\.sops\.yaml|scripts/secrets\.sh|deploy/secrets/)'; then
    echo "Running secrets check..."
    just secrets-check || { echo "  secrets check failed. Plaintext under deploy/secrets/? Policy changed? Run: just secrets-sync"; exit 1; }
fi

if git diff --cached --name-only | grep -Eq '^(\.husky/pre-commit|justfile|eslint\.config\.js|.*\.(js|cjs|mjs|ts|cts|mts|svelte))$'; then
    echo "Running eslint..."
    just lint-js || { echo "  eslint failed. Run: just lint-js"; exit 1; }
else
    echo "Skipping eslint; no relevant staged frontend files changed."
fi

# Non-blocking reminder: API-shaping backend changes usually need `just api-types`.
# CI's "API spec current" step is the real gate; this only saves a round trip.
staged=$(git diff --cached --name-only)
if echo "$staged" | grep -Eq '^backend/src/(application/dto|infrastructure/api)/' \
    && ! echo "$staged" | grep -qx 'backend/openapi.json'; then
    echo "Note: API code changed but backend/openapi.json isn't staged."
    echo "  If a DTO, handler annotation or route changed: just api-types, then stage"
    echo "  backend/openapi.json and apps/web/src/lib/api/schema.d.ts."
fi
